# Database Configuration
DATABASE_URL=postgresql+psycopg2://rca_user:rca_password@localhost:5432/rca_dashboard
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Log Configuration
LOG_LEVEL=INFO
LOG_DIR=/var/log

# System Configuration
METRICS_AGGREGATION_WINDOW=60
RCA_CORRELATION_WINDOW=300
MAX_LOG_FILE_SIZE_MB=5000

# Storage Configuration
LOG_STORAGE_PATH=./storage/logs
CHART_STORAGE_PATH=./storage/charts

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Visualization
CHART_DPI=100
CHART_STYLE=darkgrid
